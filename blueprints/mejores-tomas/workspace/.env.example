# No tool in this project loads this file automatically. Export a variable inline in the
# command that needs it. Every variable is optional for local development.

# Overrides the folder where the engine keeps its SQLite database, caches and logs.
# Default on Windows: %LOCALAPPDATA%\MejoresTomas
MT_DATA_DIR=

# Overrides the command the desktop shell uses to start the engine (debug builds only).
# Separated by spaces, for example: uv run --frozen --directory engine python -m mejores_engine
MT_ENGINE_CMD=
