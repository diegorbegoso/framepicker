{
  "name": "mejores-tomas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:ui": "vite --port 1420 --strictPort",
    "build:ui": "vite build",
    "dev": "tauri dev",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:engine": "uv run --directory engine pytest -q",
    "lint:engine": "uv run --directory engine ruff check . && uv run --directory engine ruff format --check .",
    "typecheck:engine": "uv run --directory engine mypy mejores_engine",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:sidecar": "uv run --directory engine python ../scripts/build_sidecar.py",
    "build:app": "tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
